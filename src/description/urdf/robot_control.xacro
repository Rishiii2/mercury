<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="control">
  <ros2_control name="SkidSteerSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- ── SUSPENSION JOINTS (passive differential rocker) ───────────
    ──────────────────────────────────────────────────────────────── -->
    <joint name="left_suspension_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- right_suspension_joint mirrors left at -1× via gz_ros2_control software mimic.
         This is the correct fix for Gazebo Harmonic / ROS2 Jazzy because the default
         DART physics engine does NOT support native mimic constraints at the physics
         level. gz_ros2_control reads the <param name="mimic"> tag and enforces the
         coupling in the control layer instead. -->
    <joint name="right_suspension_joint">
      <param name="mimic">left_suspension_joint</param>
      <param name="multiplier">-1.0</param>
      <param name="offset">0.0</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- ── DRIVE WHEELS ─────────────────────────────────────────── -->
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface  name="position"/>
      <state_interface  name="velocity"/>
    </joint>

    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface  name="position"/>
      <state_interface  name="velocity"/>
    </joint>

    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface  name="position"/>
      <state_interface  name="velocity"/>
    </joint>

    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface  name="position"/>
      <state_interface  name="velocity"/>
    </joint>

    <!-- ── TURRET ────────────────────────────────────────────────── -->
    <joint name="pan_joint">
      <command_interface name="position"/>
      <state_interface  name="position"/>
      <state_interface  name="velocity"/>
    </joint>

    <joint name="tilt_base_joint">
      <command_interface name="position"/>
      <state_interface  name="position"/>
      <state_interface  name="velocity"/>
    </joint>

  </ros2_control>
</xacro:macro>

</robot>
